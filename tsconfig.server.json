{
  "compilerOptions": {
    "module": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "ES2020",
    "outDir": "dist-server",
    "rootDir": ".",
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowJs": true
  },
  "exclude": ["src", "server/test", "node_modules"],
  "include": ["server", "shared-constants.ts"]
}
